# Copy this file to .env and fill in real values.
# Never commit .env or share it outside your team — see UPGRADE_NOTES.md
# for why this matters (a previous .env with live keys was accidentally
# shared and all those credentials must be rotated).

SECRET_KEY=
ADMIN_PASSWORD=
CONTACT_EMAIL=
SMTP_USER=
SMTP_PASS=
GROQ_API_KEY=
GEMINI_API_KEY=

# AI provider policy — read before touching these.
# Google's Gemini API terms prohibit use in an app "directed towards or is
# likely to be accessed by individuals under the age of 18." Nexa Pals is a
# kids' coding platform, so Gemini stays OFF (ENABLE_GEMINI=false) unless
# you've separately confirmed a compliant path for your deployment (e.g. an
# adult-only track). Groq is the default and, with this off, the only
# provider the app calls.
ENABLE_GEMINI=false
# Kill switch — set to "false" to instantly disable every AI feature
# (tutor, code helper, project generator, admin quiz builder) without a
# redeploy. Useful during an incident or a provider outage.
AI_FEATURES_ENABLED=true

# Set to "production" on your real deployment. This gates the debug
# server, HTTPS enforcement, and the demo/admin-password seeding logic.
FLASK_ENV=

# Optional. Defaults to local SQLite if unset. Point this at a real database
# before you deploy with more than one worker process — SQLite plus multiple
# gunicorn workers risks "database is locked" errors under concurrent writes.
# e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=
